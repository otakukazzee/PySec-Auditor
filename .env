# 🔹 Firebase Realtime Database Configuration
FIREBASE_URL=(isi dengan proyek database anda)

# 🔹 (Opsional) Secret / Admin Key jika database tidak public
# Bisa diambil dari Firebase Project Settings → Service Accounts → Database Secret
FIREBASE_KEY=(isi dengan key anda)

# 🔹 Optional: Timeout (default 10 detik, bisa diabaikan)
REQUEST_TIMEOUT=10


#Generate your key for all using premium tools
